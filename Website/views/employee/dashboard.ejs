<h1>Töölaud</h1>

<form method="GET" action="/employee" class="mb-4">
  <div class="row g-3">
    <div class="col-md-4">
      <label for="cityFilter" class="form-label">Linn</label>
      <select id="cityFilter" name="city" class="form-select">
        <option value="">Kõik linnad</option>
        <% (cities || []).forEach(city=> { %>
          <option value="<%= city %>" <%=String((selectedFilters || {}).city || "" )===String(city) ? "selected" : "" %>
            >
            <%= city %>
          </option>
          <% }) %>
      </select>
    </div>

    <div class="col-md-4">
      <label for="addressFilter" class="form-label">Aadress</label>
      <select id="addressFilter" name="address" class="form-select">
        <option value="">Kõik aadressid</option>
        <% (addresses || []).forEach(address=> { %>
          <option value="<%= address %>" <%=String((selectedFilters || {}).address || "" )===String(address)
            ? "selected" : "" %>>
            <%= address %>
          </option>
          <% }) %>
      </select>
    </div>

    <div class="col-md-4">
      <label for="categoryFilter" class="form-label">Juhiloa kategooria</label>
      <select id="categoryFilter" name="category_id" class="form-select">
        <option value="">Kõik kategooriad</option>
        <% (categories || []).forEach(category=> { %>
          <option value="<%= category.id %>" <%=String((selectedFilters || {}).category_id || "" )===String(category.id)
            ? "selected" : "" %>>
            <%= category.name %>
          </option>
          <% }) %>
      </select>
    </div>
  </div>

  <button type="submit" class="btn btn-primary mt-3">Filtreeri</button>
</form>

<section>
  <h2>Tänased broneeringud</h2>

  <% if (!(bookings || []).length) { %>
    <p>Broneeringuid ei leitud.</p>
    <% } %>

      <% (bookings || []).forEach(booking=> { %>
        <div class="card mb-3 p-3">
          <strong>
            <%= booking.time %>
          </strong>
          <p>
            <%= booking.client %> - <%= booking.vehicle %>
          </p>
          <p>
            <%= booking.service %>
          </p>
          <p>
            <%= booking.city %>, <%= booking.address %>
          </p>
          <span>
            <%= booking.status %>
          </span>
        </div>
        <% }) %>
</section>

<section>
  <h2>Minu kategooriad</h2>

  <% if (!(workerCategories || []).length) { %>
    <p>Kategooriaid ei leitud.</p>
    <% } %>

      <% (workerCategories || []).forEach(category=> { %>
        <span class="badge bg-primary">
          <%= category.name || category %>
        </span>
        <% }) %>
</section>

<script nonce="<%= cspNonce %>">
  (function () {
    const citySelect = document.getElementById("cityFilter");
    const addressSelect = document.getElementById("addressFilter");
    if (!citySelect || !addressSelect) return;

    const locations = <%- JSON.stringify(locations || []) %>;
    const selectedAddress = "<%= (selectedFilters || {}).address || '' %>";

    const cityToAddresses = locations.reduce((acc, loc) => {
      if (!loc || !loc.city || !loc.address) return acc;
      if (!acc[loc.city]) acc[loc.city] = [];
      if (!acc[loc.city].includes(loc.address)) acc[loc.city].push(loc.address);
      return acc;
    }, {});

    function renderAddresses(city, keepValue) {
      const values = city ? (cityToAddresses[city] || []) : [];

      addressSelect.innerHTML = "";
      const firstOpt = document.createElement("option");
      firstOpt.value = "";
      firstOpt.textContent = city ? "Kõik aadressid" : "Vali kõigepealt linn";
      addressSelect.appendChild(firstOpt);

      values.forEach((addr) => {
        const opt = document.createElement("option");
        opt.value = addr;
        opt.textContent = addr;
        if (keepValue && keepValue === addr) opt.selected = true;
        addressSelect.appendChild(opt);
      });

      addressSelect.disabled = !city;
      if (!values.includes(addressSelect.value)) {
        addressSelect.value = "";
      }
    }

    citySelect.addEventListener("change", function () {
      renderAddresses(citySelect.value, "");
    });

    renderAddresses(citySelect.value, selectedAddress);
  })();
</script>