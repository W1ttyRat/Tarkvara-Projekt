<h1>Minu graafik</h1>

<div class="schedule-layout">
  <section class="calendar-section">
    <div class="calendar-header">
      <button id="prevMonth" type="button">&lt;</button>
      <h2 id="monthTitle"></h2>
      <button id="nextMonth" type="button">&gt;</button>
    </div>

    <div class="calendar-legend">
      <span><b class="legend-available"></b> Saadaval</span>
      <span><b class="legend-selected"></b> Valitud</span>
      <span><b class="legend-unavailable"></b> Pole saadaval</span>
    </div>

    <div class="calendar-weekdays">
      <div>E</div>
      <div>T</div>
      <div>K</div>
      <div>N</div>
      <div>R</div>
      <div>L</div>
      <div>P</div>
    </div>

    <div id="calendarGrid" class="calendar-grid"></div>
  </section>

  <aside class="schedule-sidebar">
    <label>Linn</label>
    <select id="citySelect">
      <option value="">Vali linn</option>

      <% [...new Set(locations.map(location=> location.city))].forEach(city => { %>
        <option value="<%= city %>">
          <%= city %>
        </option>
        <% }) %>
    </select>

    <label>Ülevaatuspunkt</label>
    <select id="locationSelect" disabled>
      <option value="">Vali esmalt linn</option>
    </select>

    <h3>Algus</h3>
    <div id="startTimes" class="time-buttons"></div>

    <h3>Lõpp</h3>
    <div id="endTimes" class="time-buttons"></div>

    <div class="selected-box">
      <strong>Valitud kuupäevad:</strong>
      <ul id="selectedDates"></ul>
    </div>
    <div class="selected-box">
      <strong>Päeva graafik:</strong>
      <ul id="daySchedule"></ul>
    </div>

    <div class="action-buttons">
      <button id="clearBtn" type="button">Tühjenda valik</button>
      <button id="confirmBtn" type="button" disabled>Kinnita</button>
    </div>
  </aside>
</div>

<link rel="stylesheet" href="/css/pages/adminSchedule.css">
<script nonce="<%= cspNonce %>">
  window.locations = <%- JSON.stringify(locations) %>;
</script>
<script nonce="<%= cspNonce %>">
  window.workerShifts =
      <%- JSON.stringify(shifts) %>;
</script>
<script nonce="<%= cspNonce %>">
  window.csrfToken = "<%= csrfToken %>";
</script>
<script src="/js/adminSchedule.js" defer></script>
<script nonce="<%= cspNonce %>">window.csrfToken = "<%= csrfToken %>";</script>