<div class="container py-5">
    <h1 class="mb-4">Muuda töötajat</h1>

    <form method="POST" action="/boss/employees/<%= employee.user_id %>/edit">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <h4>Kasutaja andmed</h4>

        <div class="mb-3">
            <label class="form-label">Eesnimi</label>
            <input
                class="form-control"
                type="text"
                name="first_name"
                value="<%= employee.first_name %>"
                required
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Perenimi</label>
            <input
                class="form-control"
                type="text"
                name="last_name"
                value="<%= employee.last_name %>"
                required
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Kasutajanimi</label>
            <input
                class="form-control"
                type="text"
                name="username"
                value="<%= employee.username %>"
                required
            >
        </div>

        <hr>

        <h4>Töötaja andmed</h4>

        <div class="mb-3">
            <label class="form-label">Nimi</label>
            <input
                class="form-control"
                type="text"
                name="name"
                value="<%= employee.name || '' %>"
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input
                class="form-control"
                type="email"
                name="email"
                value="<%= employee.email || '' %>"
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Telefon</label>
            <input
                class="form-control"
                type="text"
                name="phone"
                value="<%= employee.phone || '' %>"
            >
        </div>

        <hr>

        <h4>Lubade kategooriad</h4>

        <% licenceCategories.forEach(category => { %>
            <div class="form-check">
                <input
                    class="form-check-input"
                    type="checkbox"
                    name="licence_category_ids"
                    value="<%= category.id %>"
                    id="category-<%= category.id %>"
                    <%= selectedLicenceIds.includes(category.id) ? "checked" : "" %>
                >

                <label
                    class="form-check-label"
                    for="category-<%= category.id %>"
                >
                    <%= category.code %> — <%= category.name %>
                </label>
            </div>
        <% }) %>

        <button class="btn btn-primary mt-4" type="submit">
            Salvesta
        </button>

        <a href="/boss/employees" class="btn btn-secondary mt-4">
            Tagasi
        </a>
    </form>
</div>