<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">Töölaud</h1>

            <div class="row g-4 mb-4">
                <div class="col-md-6 col-lg-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <p class="text-muted mb-1">Ootel taotlused</p>
                            <h2><%= stats.pendingRequests %></h2>
                        </div>
                    </div>
                </div>
            
                <div class="col-md-6 col-lg-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <p class="text-muted mb-1">Tühjad päevad sel kuul</p>
                            <h2><%= stats.emptyDaysThisMonth %></h2>
                        </div>
                    </div>
                </div>
            </div>

            <% if (typeof bossName !== "undefined" && bossName) { %>
                <p class="text-muted">
                    Tere, <%= bossName %>!
                </p>
            <% } %>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h5 class="card-title mb-3">Registreeri töötaja</h5>
                    <p class="card-text text-muted">Lisa uus töötaja süsteemi</p>
                    <a href="/boss/register-employee" class="btn btn-primary">
                        Registreeri
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h5 class="card-title mb-3">Vaata töötajaid</h5>
                    <p class="card-text text-muted">Halda töötajate nimekirja</p>
                    <a href="/boss/employees" class="btn btn-primary">
                        Vaata
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h5 class="card-title mb-3">Graafik</h5>
                    <p class="card-text text-muted">Vaata ja kinnita tööaegu</p>
                    <a href="/boss/schedule" class="btn btn-primary">
                        Ava graafik
                    </a>
                </div>
            </div>
        </div>
    </div>

    <form action="/auth/logout" method="POST" class="mt-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-outline-danger" type="submit">
            Logi välja
        </button>
    </form>
</div>