<div class="container py-5">
    <h1 class="mb-4">Töötajad</h1>

    <% if (employees.length === 0) { %>
        <p class="text-muted">Töötajaid ei leitud.</p>
    <% } else { %>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Eesnimi</th>
                    <th>Perenimi</th>
                    <th>Kasutajanimi</th>
                    <th>Roll</th>
                </tr>
            </thead>

            <tbody>
                <% employees.forEach(employee => { %>
                    <tr>
                        <td><%= employee.id %></td>
                        <td><%= employee.first_name %></td>
                        <td><%= employee.last_name %></td>
                        <td><%= employee.username %></td>
                        <td><%= employee.role %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

    <% } %>

    <a href="/boss" class="btn btn-secondary mt-3">
        Tagasi
    </a>
</div>