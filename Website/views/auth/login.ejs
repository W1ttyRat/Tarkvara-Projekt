<section class="row justify-content-center py-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-3 text-center">Tere tulemast</h1>
                <p class="text-muted text-center mb-4">Logi sisse oma kontosse</p>

                <form action="/auth/login" method="POST" novalidate>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-3">
                        <label for="username" class="form-label">Kasutajanimi</label>
                        <input type="text" class="form-control" id="username" name="username"
                            placeholder="kasuta 'boss' või 'employee'" required />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Parool</label>
                        <input type="password" class="form-control" id="password" name="password"
                            placeholder="Sisesta parool" required minlength="6" autocomplete="current-password" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 my-3">Logi sisse</button>
                </form>

                <hr class="my-4" />

            </div>
        </div>
    </div>
</section>