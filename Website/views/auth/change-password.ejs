<section class="row justify-content-center py-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-3 text-center">Muuda parooli</h1>
                <p class="text-muted text-center mb-4">Esmakordselt sisselogimise puhul peate parooli muutma</p>

                <% if (errorMessage) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= errorMessage %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                    <% } %>

                        <form action="/auth/change-password" method="POST" novalidate>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <div class="mb-3">
                                <label for="password" class="form-label">Uus parool</label>
                                <input type="password" class="form-control" id="password" name="password"
                                    placeholder="Vähemalt 8 märki" required minlength="8" autocomplete="new-password" />
                                <small class="text-muted">Vähemalt 8 märki, milles on täht ja number</small>
                            </div>

                            <div class="mb-3">
                                <label for="confirm_password" class="form-label">Kinnita uus parool</label>
                                <input type="password" class="form-control" id="confirm_password"
                                    name="confirm_password" placeholder="Kinnita uus parool" required minlength="8"
                                    autocomplete="new-password" />
                            </div>

                            <button type="submit" class="btn btn-primary w-100 my-3">Muuda parooli</button>
                        </form>
            </div>
        </div>
    </div>
</section>